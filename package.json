{
  "name": "cinev-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --base /",
    "postbuild": "node scripts/prepare-pages.mjs",
    "post:new": "node scripts/new-post.mjs",
    "check": "npm run build && npm run test:publishing && npm run test:seo && npm run test:rss && npm run test:legacy && npm run test:media && npm run test:assets && python3 scripts/verify-build.py",
    "test:publishing": "node scripts/test-publishing.mjs",
    "test:seo": "node scripts/test-tracking-check.mjs && node scripts/verify-seo.mjs",
    "test:rss": "node scripts/verify-rss.mjs",
    "test:legacy": "node scripts/verify-legacy-links.mjs",
    "test:media": "python3 scripts/verify-media.py",
    "test:assets": "node scripts/test-deployment-assets.mjs && node scripts/verify-site-assets.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "7.3.5",
    "@astrojs/markdown-remark": "7.3.1",
    "cheerio": "1.2.0"
  }
}
