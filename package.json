{
  "name": "cinev-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "postbuild": "node scripts/prepare-pages.mjs",
    "post:new": "node scripts/new-post.mjs",
    "check": "npm run build && python3 scripts/verify-build.py",
    "test:publishing": "node scripts/test-publishing.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "7.3.5",
    "@astrojs/markdown-remark": "7.3.1",
    "cheerio": "1.2.0"
  }
}
